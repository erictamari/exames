generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Specialty {
  id                Int           @id @default(autoincrement())
  name              String
  slug              String        @unique
  icon              String?
  lastVisit         DateTime?
  nextAppointment   DateTime?
  improvement       String?
  actions           String?
  medications       String?
  appointments      Appointment[]
  exams             Exam[]
  bloodResults      BloodResult[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Appointment {
  id           Int        @id @default(autoincrement())
  specialtyId  Int
  specialty    Specialty  @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  date         DateTime
  doctor       String?
  location     String?
  notes        String?
  status       String     @default("AGENDADA")
  createdAt    DateTime   @default(now())
}

model Exam {
  id           Int        @id @default(autoincrement())
  specialtyId  Int
  specialty    Specialty  @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  name         String
  date         DateTime
  notes        String?
  fileName     String?
  filePath     String?
  fileType     String?
  createdAt    DateTime   @default(now())
}

model BloodResult {
  id           Int        @id @default(autoincrement())
  specialtyId  Int?
  specialty    Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  marker       String
  value        Float
  unit         String?
  referenceMin Float?
  referenceMax Float?
  date         DateTime
  notes        String?
  createdAt    DateTime   @default(now())
}
